{
  "manifest_version": 3,
  "name": "Prompt Gateway",
  "version": "0.3.2",
  "description": "Local-first prompt repository, chat registry, composer, and usage ledger.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://copilot.microsoft.com/*",
    "https://perplexity.ai/*",
    "https://www.perplexity.ai/*",
    "https://poe.com/*",
    "https://grok.com/*",
    "https://x.com/*",
    "https://huggingface.co/*",
    "https://huggingface.chat/*",
    "https://chat.mistral.ai/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://chat.qwen.ai/*",
    "https://qwen.ai/*",
    "https://kimi.com/*",
    "https://www.kimi.com/*",
    "https://meta.ai/*",
    "https://www.meta.ai/*",
    "https://character.ai/*",
    "https://www.character.ai/*",
    "https://you.com/*",
    "https://phind.com/*",
    "https://www.phind.com/*",
    "https://openrouter.ai/*",
    "https://chat.lmsys.org/*",
    "https://aistudio.google.com/*",
    "https://notebooklm.google.com/*",
    "https://manus.im/*",
    "https://www.manus.im/*",
    "https://app.manus.im/*",
    "https://chat.z.ai/*",
    "https://z.ai/*",
    "https://chatglm.cn/*",
    "https://www.doubao.com/*",
    "https://claude.com/*",
    "https://chat.baidu.com/*",
    "https://yiyan.baidu.com/*",
    "https://chat.163.com/*",
    "https://chat.together.ai/*",
    "https://pi.ai/*",
    "https://www.pi.ai/*",
    "https://www.chaindesk.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Prompt Gateway"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://perplexity.ai/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*",
        "https://grok.com/*",
        "https://x.com/*",
        "https://huggingface.co/*",
        "https://huggingface.chat/*",
        "https://chat.mistral.ai/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://chat.qwen.ai/*",
        "https://qwen.ai/*",
        "https://kimi.com/*",
        "https://www.kimi.com/*",
        "https://meta.ai/*",
        "https://www.meta.ai/*",
        "https://character.ai/*",
        "https://www.character.ai/*",
        "https://you.com/*",
        "https://phind.com/*",
        "https://www.phind.com/*",
        "https://openrouter.ai/*",
        "https://chat.lmsys.org/*",
        "https://aistudio.google.com/*",
        "https://notebooklm.google.com/*",
        "https://manus.im/*",
        "https://www.manus.im/*",
        "https://app.manus.im/*",
        "https://chat.z.ai/*",
        "https://z.ai/*",
        "https://chatglm.cn/*",
        "https://www.doubao.com/*",
        "https://claude.com/*",
        "https://chat.baidu.com/*",
        "https://yiyan.baidu.com/*",
        "https://chat.163.com/*",
        "https://chat.together.ai/*",
        "https://pi.ai/*",
        "https://www.pi.ai/*",
        "https://www.chaindesk.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "Open Prompt Gateway"
    }
  },
  "oauth2": {
    "client_id": "892946661643-gb5uvm4rm3d0neun1g15dmbaal13rk1c.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.appdata"
    ]
  }
}
